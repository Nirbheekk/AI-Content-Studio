# -----------------------------------------------------------------------------
# AI Content Operating System — Environment Configuration Template
# Copy to .env for local development. NEVER commit .env to version control.
# -----------------------------------------------------------------------------

NODE_ENV=development

# Ports & Endpoints
FRONTEND_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostgreSQL 16
POSTGRES_USER=aicos
POSTGRES_PASSWORD=aicos_dev_password_change_me
POSTGRES_DB=ai_content_os
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aicos:aicos_dev_password_change_me@localhost:5432/ai_content_os?schema=public

# Redis 7
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO (S3-Compatible Object Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev_password
S3_BUCKET_RAW=aicos-raw-assets
S3_BUCKET_DERIVATIVES=aicos-derivatives
S3_BUCKET_RENDERS=aicos-renders

# Security & Cryptography (Generate random 64-hex key for production)
JWT_SECRET=dev_jwt_secret_minimum_32_characters_long_for_local_testing_only
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI Providers (Leave blank in local dev to use [SIMULATED] fallback adapters)
AI_PRIMARY_LLM_PROVIDER=simulated
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Postiz Social Publishing Integration
POSTIZ_API_URL=http://localhost:5000/public/v1
POSTIZ_API_KEY=
