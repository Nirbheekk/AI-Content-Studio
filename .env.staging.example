# -----------------------------------------------------------------------------
# AI Content Operating System — Staging Environment Template (4 vCPU / 8 GB RAM)
# Copy to .env.staging on the staging server. NEVER commit .env.staging to Git.
# -----------------------------------------------------------------------------

NODE_ENV=production

# Public Staging URL (Replace with your staging IP or private domain)
NEXT_PUBLIC_API_URL=https://staging.example.com/api/v1
CORS_ALLOWED_ORIGINS=https://staging.example.com

# PostgreSQL 16 (Generate strong random password: openssl rand -base64 36)
POSTGRES_USER=aicos_staging
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=ai_content_os_staging

# Redis 7 (Generate strong random password: openssl rand -base64 36)
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# MinIO / S3-Compatible Storage
MINIO_ROOT_USER=aicos_minio_staging
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_MINIO_PASSWORD
S3_PUBLIC_ENDPOINT=https://staging.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY=aicos_minio_staging
S3_SECRET_KEY=REPLACE_WITH_STRONG_MINIO_PASSWORD
S3_BUCKET_RAW=aicos-raw-assets
S3_BUCKET_DERIVATIVES=aicos-derivatives
S3_BUCKET_RENDERS=aicos-renders

# Security & Cryptography (REQUIRED: generate unique keys with openssl rand)
# JWT_SECRET: openssl rand -base64 48
# ENCRYPTION_MASTER_KEY: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_UNIQUE_48_CHAR_JWT_SECRET
ENCRYPTION_MASTER_KEY=REPLACE_WITH_UNIQUE_64_HEX_CHAR_MASTER_KEY

# AI Providers (Must explicitly set 'gemini' / 'openai' / 'anthropic' or 'simulated')
AI_PRIMARY_LLM_PROVIDER=simulated
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Postiz Social Publishing (Leave blank in staging unless testing sandbox/private test account)
POSTIZ_API_URL=
POSTIZ_API_KEY=
